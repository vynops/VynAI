# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# VynAI runtime data — contains SSH passwords, API keys, server registry
# NEVER commit this directory
data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local deployment helper scripts
_deploy_*.sh
_nginx_vynai.conf
_nginx_vynops_ops.conf

